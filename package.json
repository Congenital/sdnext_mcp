{
  "name": "sdnext-mcp",
  "version": "1.0.0",
  "description": "Model Context Protocol (MCP) server for SD.Next — covers all SD.Next API usage scenarios (txt2img, img2img, process, caption, VQA, models, LoRA, options, history, CivitAI, ...)",
  "type": "module",
  "license": "MIT",
  "bin": { "sdnext-mcp": "src/index.js" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "check": "node --check src/index.js && echo OK",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "engines": { "node": ">=18" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "vitest": "^3.2.7"
  }
}
